{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemini-2.0-flash-001",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "nanoclaw": {
      "type": "local",
      "command": [
        "node",
        "/tmp/dist/ipc-mcp-stdio.js"
      ],
      "environment": {
        "NANOCLAW_CHAT_JID": "q@g.us",
        "NANOCLAW_GROUP_FOLDER": "quick",
        "NANOCLAW_IS_MAIN": "0"
      }
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}