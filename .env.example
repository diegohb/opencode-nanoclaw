# ============================================
# Anthropic / OpenRouter API Configuration
# ============================================
# Choose ONE of the following for model access:
# OpenRouter (recommended - has free tier)
# OPENROUTER_API_KEY=your_openrouter_key_here

# Anthropic (paid)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Custom Anthropic-compatible endpoint
# ANTHROPIC_BASE_URL=https://your-api-endpoint.com
# ANTHROPIC_AUTH_TOKEN=your-token-here

# Optional: Explicit provider/model selection
# OPENCODE_PROVIDER=opencode
# OPENCODE_MODEL=claude-sonnet-4-20250514

# ============================================
# Assistant Configuration
# ============================================
# ASSISTANT_NAME=Andy
# ASSISTANT_HAS_OWN_NUMBER=false

# ============================================
# Container Configuration
# ============================================
# CONTAINER_IMAGE=nanoclaw-agent:latest
# CONTAINER_TIMEOUT=1800000
# CONTAINER_MAX_OUTPUT_SIZE=10485760
# IDLE_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5

# ============================================
# Credential Proxy Configuration
# ============================================
# CREDENTIAL_PROXY_HOST=http://host.docker.internal
# CREDENTIAL_PROXY_PORT=3001

# ============================================
# Logging
# ============================================
# LOG_LEVEL=info

# ============================================
# Timezone
# ============================================
# TZ=UTC

# ============================================
# MS Teams Bot Framework credentials
# ============================================
# TEAMS_APP_ID=
# TEAMS_APP_SECRET=
# TEAMS_PORT=3978
